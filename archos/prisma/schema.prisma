generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// PLATFORM CORE
// -----------------------------------------------------------------------------

model User {
  id             String               @id @default(uuid())
  supabaseUserId String?              @unique
  email          String               @unique
  name           String
    profession     String?
  passwordHash   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  
  memberships   OrganizationMember[]
  notifications Notification[]
  projectMemberships ProjectMember[]
}

model Organization {
  id            String               @id @default(uuid())
  name          String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  members       OrganizationMember[]
  entitlements  AppEntitlement[]
  contacts      Contact[]
  files         File[]
  notifications Notification[]
  auditLogs     AuditLog[]
  activities    Activity[]
  
  // App specific relations
  leads         Lead[]
  opportunities Opportunity[]
  projects      Project[]
  tasks         Task[]
  projectMembers ProjectMember[]
  expenses      Expense[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         String       @default("ACTIVE") // ACTIVE, INVITED, INACTIVE

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
}

model Role {
  id             String               @id @default(uuid())
  organizationId String?              // null means system-level role (e.g., default Admin)
  name           String
    profession     String?
  
  permissions    RolePermission[]
  members        OrganizationMember[]

  @@unique([organizationId, name])
}

model RolePermission {
  id         String @id @default(uuid())
  roleId     String
  permission String // e.g. "CRM.LEADS.READ", "PROJECTS.TASK.WRITE"

  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

model AppEntitlement {
  id             String       @id @default(uuid())
  organizationId String
  appId          String       // e.g. "CRM", "PROJECTS", "ACCOUNTS"
  status         String       @default("ACTIVE") // ACTIVE, SUSPENDED

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, appId])
}

// -----------------------------------------------------------------------------
// SHARED MODELS (Platform maintained)
// -----------------------------------------------------------------------------

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  name           String
    profession     String?
  email          String?
  phone          String?
  company        String?
  metadata       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // App specific relations
  leads          Lead[]
  opportunities  Opportunity[]
  projects       Project[]
}

model File {
  id             String       @id @default(uuid())
  organizationId String
  name           String
    profession     String?
  url            String       // Path or cloud URL
  uploadedById   String?      
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  type           String
  title          String
  message        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String
  action         String       // e.g. "PROJECT_CREATED"
  entityType     String       // e.g. "Project"
  entityId       String
  metadata       String?
  timestamp      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String
  type           String       // e.g. "COMMENT_ADDED", "STATUS_CHANGED"
  entityType     String
  entityId       String
  sourceApp      String       // e.g. "CRM", "PROJECTS"
  metadata       String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// APP-SPECIFIC MODELS
// -----------------------------------------------------------------------------

// CRM
model Lead {
  id             String   @id @default(uuid())
  organizationId String
  contactId      String
  title          String
  status         String
  estimatedValue Float
  assignedTo     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id             String   @id @default(uuid())
  organizationId String
  contactId      String
  name           String
    profession     String?
  value          Float
  stage          String
  ownerId        String
  expectedCloseDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

// Projects
model Project {
  id             String   @id @default(uuid())
  organizationId String
  clientId       String
  sourceOpportunityId String?
  name           String
    profession     String?
  budget         Float
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Contact      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks          Task[]
  members        ProjectMember[]
  expenses       Expense[]
}

model Task {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  title          String
  status         String   @default("TODO")
  assigneeId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  userId         String
  role           String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Accounts
model Expense {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  category       String
  description    String
  amount         Float
  date           DateTime @default(now())
  createdById    String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
